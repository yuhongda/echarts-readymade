{
  "name": "echarts-readymade-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "version": "1.0.0",
  "description": "A collection of echarts templates for React. Based on echarts-for-react",
  "repository": "https://yuhongda@github.com/yuhongda/echarts-readymade.git",
  "author": "yuhongda <silverage.y@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter 'demo' dev",
    "build": "pnpm -w --filter @echarts-readymade/core run build && pnpm -w --filter '!@echarts-readymade/core' --filter '@echarts-readymade/*' run build && pnpm -w --filter echarts-readymade run build",
    "version": "lerna version",
    "release": "pnpm publish --filter '@echarts-readymade/*' --filter echarts-readymade",
    "test": "vitest",
    "vitest:clear": "vitest --clearCache",
    "cover": "pnpm run vitest:clear && vitest run --coverage",
    "make-badges": "istanbul-badges-readme --coverageDir=__test__/coverage"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "antd": "^6.5.0",
    "axios": "^0.24.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "esbuild": "^0.14.2",
    "istanbul-badges-readme": "^1.8.0",
    "jsdom": "^30.0.1",
    "lerna": "^9.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rolldown": "^1.2.0",
    "styled-components": "^6.1.3",
    "ts-node": "^10.4.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0",
    "wordcloud": "^1.2.2",
    "wrangler": "^4.110.0"
  }
}
