{
  "name": "echarts-readymade-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "version": "1.0.0",
  "description": "A collection of echarts templates for React. Based on echarts-for-react",
  "repository": "https://yuhongda@github.com/yuhongda/echarts-readymade.git",
  "author": "yuhongda <silverage.y@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter 'demo' dev",
    "build": "pnpm -w --filter @echarts-readymade/core run build && pnpm -w --filter '!@echarts-readymade/core' --filter '@echarts-readymade/*' run build && pnpm -w --filter echarts-readymade run build",
    "version": "lerna version",
    "release": "pnpm publish --filter '@echarts-readymade/*' --filter echarts-readymade",
    "test": "NODE_ENV=test jest",
    "jest:clear": "jest --clearCache",
    "cover": "yarn run jest:clear && jest --coverage --config=jest.config.ts"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@changesets/cli": "^2.28.1",
    "@testing-library/jest-dom": "^5.16.1",
    "@testing-library/react": "^12.1.2",
    "@testing-library/react-hooks": "^7.0.2",
    "@types/enzyme": "^3.10.10",
    "@types/jest": "^26.0.24",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@wojtekmaj/enzyme-adapter-react-17": "^0.6.3",
    "antd": "^6.5.0",
    "axios": "^0.24.0",
    "babel-jest": "^27.0.6",
    "codecov": "^3.8.3",
    "enzyme": "^3.11.0",
    "esbuild": "^0.14.2",
    "istanbul-badges-readme": "^1.8.0",
    "jest": "^27.0.6",
    "jest-canvas-mock": "2.5.2",
    "jest-css-modules-transform": "^4.3.0",
    "jest-enzyme": "^7.1.2",
    "lerna": "^9.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rolldown": "^1.2.0",
    "styled-components": "^6.1.3",
    "ts-node": "^10.4.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "wordcloud": "^1.2.2",
    "wrangler": "^4.110.0"
  }
}
